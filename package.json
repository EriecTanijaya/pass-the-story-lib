{
  "name": "pass-the-story-lib",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "vite dev --port 3000 --mode dev --host",
    "build": "vite build",
    "preview": "bun run build && vite preview",
    "test": "vitest run",
    "lint": "oxlint --fix",
    "deploy": "bun run build --mode prod && wrangler secret bulk .env.prod && wrangler deploy",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "cf:typegen": "wrangler types",
    "tsc": "tsc",
    "auth-db:push": "bunx @better-auth/cli generate --config ./src/app/auth/lib/betterAuth/authServer.ts --output ./src/app/auth/lib/betterAuth/authTable.ts && bun db:push"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@cloudflare/vite-plugin": "^1.29.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-query": "^5.91.2",
    "@tanstack/react-router": "^1.167.5",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@tanstack/react-router-ssr-query": "^1.166.9",
    "@tanstack/react-start": "^1.166.18",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.166.14",
    "@types/bun": "^1.3.11",
    "arktype": "^2.2.0",
    "better-auth": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.0.1",
    "oxlint": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.0",
    "web-vitals": "^5.1.0",
    "wrangler": "^4.75.0"
  }
}
